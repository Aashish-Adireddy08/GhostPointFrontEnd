diff --git a/modules/uwb-ar/WaypointControls.tsx b/modules/uwb-ar/WaypointControls.tsx
new file mode 100644
--- /dev/null
+++ b/modules/uwb-ar/WaypointControls.tsx
@@ -0,0 +1,66 @@
+import { useEffect, useState } from 'react';
+import { Button, StyleSheet, Text, View } from 'react-native';
+import { requireNativeModule } from 'expo';
+
+const native = requireNativeModule('UwbAr');
+export function WaypointControls({ server, device }: { server: string; device: string }) {
+  const [allowed, setAllowed] = useState(false);
+  const [message, setMessage] = useState('Waiting for waypoint permission…');
+  const [hasPoint, setHasPoint] = useState(false);
+  useEffect(() => {
+    const controller = new AbortController();
+    let timer: ReturnType<typeof setTimeout>;
+    let currentPermission = false;
+    const post = async (action: string, payload: object) => {
+      const response = await fetch(server + '/waypoint/' + action, {
+        method: 'POST', headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ device, ...payload }), signal: controller.signal,
+      });
+      const state = await response.json();
+      if (!response.ok) throw new Error(state.error || 'Waypoint request failed');
+      return state;
+    };
+    const poll = async () => {
+      try {
+        const state = await post('phone', {});
+        if (controller.signal.aborted) return;
+        currentPermission = state.canPlace;
+        setAllowed(state.canPlace);setHasPoint(Boolean(state.point));
+        await native.updateWaypoint(state.point?.reference ?? null, state.canPlace);
+        if (!state.point) setMessage(state.canPlace ? 'You can place the team waypoint.' : 'Choose a phone in the website waypoint controls.');
+      } catch (error) {
+        if (!controller.signal.aborted) {
+          currentPermission = false;setAllowed(false);
+          void native.updateWaypoint(null, false);
+          setMessage(error instanceof Error ? error.message : 'Waypoint connection lost');
+        }
+      } finally { if (!controller.signal.aborted) timer = setTimeout(poll, 1000); }
+    };
+    const tap = native.addListener('onWaypointTap', (event: { reference: object }) => {
+      if (!currentPermission) return;
+      void post('set', { reference: event.reference }).then(state => {
+        if (!controller.signal.aborted) {
+          void native.updateWaypoint(state.point?.reference ?? null, state.canPlace);
+          setHasPoint(Boolean(state.point));setMessage('Waypoint shared with the team.');
+        }
+      }).catch(error => { if (!controller.signal.aborted) setMessage(error.message); });
+    });
+    const status = native.addListener('onWaypointStatus', (event: { message: string }) => {
+      if (!controller.signal.aborted) setMessage(event.message);
+    });
+    void poll();
+    return () => {controller.abort();clearTimeout(timer);tap.remove();status.remove();void native.updateWaypoint(null, false);};
+  }, [server, device]);
+  return <View style={styles.panel}>
+    <Text style={styles.title}>◆ TEAM WAYPOINT</Text>
+    <Text style={styles.text}>{message}</Text>
+    {allowed && <Button color="#ffbd42" title={hasPoint ? 'Replace waypoint' : 'Place waypoint'} onPress={() => {
+      void native.armWaypoint();setMessage('Tap a visible floor or wall in the camera view.');
+    }} />}
+  </View>;
+}
+const styles = StyleSheet.create({
+  panel: { borderWidth: 1, borderColor: '#ffbd42', borderRadius: 3, padding: 5, marginTop: 4, backgroundColor: '#211b10' },
+  title: { color: '#ffbd42', fontWeight: 'bold', fontSize: 12, textAlign: 'center' },
+  text: { color: '#ffe4aa', fontSize: 11, textAlign: 'center' },
+});
diff --git a/modules/uwb-ar/ios/WaypointOverlay.swift b/modules/uwb-ar/ios/WaypointOverlay.swift
new file mode 100644
--- /dev/null
+++ b/modules/uwb-ar/ios/WaypointOverlay.swift
@@ -0,0 +1,109 @@
+import ARKit
+import RealityKit
+import UIKit
+
+// Main-queue state; video frames remain entirely in the existing native publisher.
+enum WaypointBridge {
+    static var reference: [String: Any]?
+    static var canPlace = false
+    static var armed = false
+    static var onEvent: ((String, [String: Any]) -> Void)?
+}
+
+final class WaypointOverlay: NSObject {
+    private weak var arView: ARView?
+    private weak var tracker: UWBTracker?
+    private let root = AnchorEntity(world: .zero)
+    private let marker = ModelEntity(mesh: .generateBox(size: 0.09), materials: [UnlitMaterial(color: .systemOrange)])
+    private let label = UILabel()
+    private var gesture: UITapGestureRecognizer?
+    private var lastStatus = ""
+
+    init(arView: ARView, tracker: UWBTracker, container: UIView) {
+        self.arView = arView
+        self.tracker = tracker
+        super.init()
+        marker.orientation = simd_quatf(angle: .pi / 4, axis: SIMD3(0, 0, 1))
+        marker.isEnabled = false
+        root.addChild(marker)
+        arView.scene.addAnchor(root)
+        label.bounds = CGRect(x: 0, y: 0, width: 190, height: 58)
+        label.numberOfLines = 2
+        label.font = .monospacedSystemFont(ofSize: 14, weight: .bold)
+        label.textColor = .systemOrange
+        label.textAlignment = .center
+        label.backgroundColor = UIColor(white: 0.08, alpha: 0.9)
+        label.layer.borderColor = UIColor.systemOrange.cgColor
+        label.layer.borderWidth = 2
+        label.layer.cornerRadius = 3
+        label.isUserInteractionEnabled = false
+        label.isHidden = true
+        container.addSubview(label)
+        let tap = UITapGestureRecognizer(target: self, action: #selector(place(_:)))
+        tap.cancelsTouchesInView = false
+        arView.addGestureRecognizer(tap)
+        gesture = tap
+    }
+
+    func stop() {
+        if let gesture { arView?.removeGestureRecognizer(gesture) }
+        root.removeFromParent()
+        label.removeFromSuperview()
+        WaypointBridge.armed = false
+    }
+
+    private func status(_ text: String) {
+        guard text != lastStatus else { return }
+        lastStatus = text
+        WaypointBridge.onEvent?("onWaypointStatus", ["message": text])
+    }
+
+    @objc private func place(_ tap: UITapGestureRecognizer) {
+        guard WaypointBridge.canPlace, WaypointBridge.armed, let arView, let tracker else { return }
+        guard let result = arView.raycast(from: tap.location(in: arView), allowing: .estimatedPlane, alignment: .any).first else {
+            status("No surface found. Scan slowly, then tap a floor or wall.")
+            return
+        }
+        let p = result.worldTransform.columns.3
+        guard let reference = tracker.waypointReference(SIMD3(p.x, p.y, p.z)) else {
+            status("AR tracking is not ready. Move slowly and try again.")
+            return
+        }
+        WaypointBridge.armed = false
+        WaypointBridge.onEvent?("onWaypointTap", ["reference": reference])
+        status("Sending waypoint…")
+    }
+
+    func tick(camera: ARCamera) {
+        marker.isEnabled = false
+        label.isHidden = true
+        guard let arView, let tracker, let reference = WaypointBridge.reference else {
+            if WaypointBridge.armed { status("Tap a visible surface to place the waypoint.") }
+            return
+        }
+        guard let peer = reference["peer"] as? String,
+              let epoch = reference["epoch"] as? NSNumber,
+              let xyz = reference["position"] as? [Double], xyz.count == 3,
+              let p = tracker.mapWaypoint(SIMD3(Float(xyz[0]), Float(xyz[1]), Float(xyz[2])),
+                                          from: peer, epoch: epoch.uint32Value, at: CACurrentMediaTime()) else {
+            status("Waypoint shared. Waiting for peer AR alignment or valid tracking.")
+            return
+        }
+        marker.position = p
+        marker.isEnabled = true
+        let t = camera.transform.columns.3
+        let distance = simd_distance(p, SIMD3(t.x, t.y, t.z))
+        let cam = camera.viewMatrix(for: .portrait) * SIMD4(p, 1)
+        let projected = arView.project(p)
+        let inside = cam.z < 0 && projected.map { arView.bounds.insetBy(dx: 100, dy: 130).contains($0) } == true
+        if inside, let projected {
+            label.center = CGPoint(x: projected.x, y: projected.y - 48)
+            label.text = String(format: "◆ WAYPOINT\n%.1f m", distance)
+        } else {
+            label.center = CGPoint(x: arView.bounds.midX, y: 160)
+            label.text = String(format: "◆ WAYPOINT · OFF SCREEN\n%.1f m", distance)
+        }
+        label.isHidden = false
+        status(WaypointBridge.armed ? "Tap a surface to replace the waypoint." : "Shared waypoint active.")
+    }
+}
